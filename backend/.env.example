# Copy to backend/.env (never commit the real file) or set these in the hosting platform.

# --- required ---------------------------------------------------------------------------
MONGO_URL=mongodb://localhost:27017
DB_NAME=edikimou
# Long random value: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# --- email (Emergent managed email / Resend); without a key no email or verification code is sent ---
EMERGENT_EMAIL_KEY=
EMAIL_FROM_NAME=e-dikiΜου
EMAIL_REPLY_TO=

# --- SMS + voice calls (optional); the SMS/call options are disabled in the UI when unset ----------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- behaviour (defaults shown) -----------------------------------------------------------------
MONITOR_INTERVAL_SECONDS=120
STUCK_MINUTES=20
FEED_DOWN_AFTER_CHECKS=3
EDIKI_CONCURRENCY=6
DOCKET_CACHE_TTL_SECONDS=15
FUTURE_CHECK_MINUTES=30

# --- deployment --------------------------------------------------------------------------------
# Comma-separated browser origins allowed to call the API, e.g. https://edikimou.example.gr
CORS_ORIGINS=*
# Set to 1 only behind a reverse proxy that overwrites X-Forwarded-For (rate limits use the client IP)
TRUST_PROXY=0
